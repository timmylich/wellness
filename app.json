{
  "expo": {
    "name": "Wellness",
    "slug": "wellness",
    "scheme": "wellness",
    "version": "0.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "io.github.timmylich.wellness",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#2E9E6A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.timmylich.wellness",
      "infoPlist": {
        "NSMotionUsageDescription": "Wellness считает шаги с помощью датчика движения."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-localization",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#2E9E6A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1B6B47"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wellness uses the camera to attach photos of medical reports to your health records.",
          "photosPermission": "Wellness attaches photos of medical reports to your health records."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
